# FounderMate backend environment variables
# Copy this file to .env (root) and fill in real values for docker-compose.
# NEVER commit the real .env file.

# ---- REQUIRED: JWT signing key ----
# MUST be at least 32 bytes (256 bits) for HMAC-SHA256; the API refuses to
# start with a missing/short key (fail-fast). Generate one with:
#   openssl rand -base64 48
# or:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- REQUIRED in production: CORS ----
# The exact public origin of the deployed frontend. docker-compose.prod.yml
# maps this to Cors__AllowedOrigins__0. To allow more origins, add additional
# Cors__AllowedOrigins__1, __2, ... entries to docker-compose.prod.yml.
APP_ORIGIN=

# ---- OPTIONAL: SQLite path / connection string ----
# Default "Data Source=foundermate.db" resolves relative to the working
# directory. In production point at persistent storage (e.g. a mounted volume):
# Example: ConnectionStrings__DefaultConnection="Data Source=/var/data/foundermate.db"
# ConnectionStrings__DefaultConnection=

# ---- OPTIONAL: Media uploads (not used by the MVP) ----
# Future functionality. If enabled, you must publish public URLs for uploads:
# Example: FileUpload__BaseUrl=https://api.<your-domain>/
# FileUpload__BaseUrl=

# ---- OPTIONAL: AI (DISABLED by default in production) ----
# The MVP does not use AI. The API starts fine with no key and no
# Ai__ApiKey; AI endpoints return a clean 400 when disabled.
# Ai__Enabled=true
# Ai__ApiKey=

# ---- OPTIONAL: reverse proxy + rate limiting ----
# Rate limiting is enabled; when behind a proxy, declare its network so the
# real client IP is seen:
#   ForwardedHeaders__KnownNetworks__0=<proxy CIDR, e.g. 172.16.0.0/12>
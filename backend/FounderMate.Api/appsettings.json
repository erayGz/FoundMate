{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=foundermate.db"
  },
  "Jwt": {
    "Secret": "SuperSecretKey1234567890abcdefghijklmnop",
    "Issuer": "FounderMate",
    "Audience": "FounderMate",
    "ExpiryInMinutes": 1440
  },
  "FileUpload": {
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
    "UploadPath": "uploads",
    "BaseUrl": "http://localhost:5000"
  },
  "Ai": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "Endpoint": "",
    "DeploymentName": "gpt-4o-mini",
    "Model": "gpt-4o-mini",
    "MaxTokens": 2000,
    "Temperature": 0.7,
    "Enabled": true
  }
}

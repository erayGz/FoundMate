# Keep the Docker build context small and free of secrets/artifacts.
# Build context is the repository root (docker build -f FounderMate.Api/Dockerfile .)

# Version control and local config
.git
.gitignore
.env
.env.*

# Frontend (not part of the API image)
frontend/
node_modules/
dist/

# .NET build artifacts (regenerated inside the image)
**/bin
**/obj
.vs/

# Local SQLite databases and uploads
*.db
*.db-journal
*.db-shm
*.db-wal
**/data
uploads/

# Docs and proxy config not needed in the API image
docs/
nginx/
*.md
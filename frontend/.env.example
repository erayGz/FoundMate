# FounderMate frontend environment variables
# Copy this file to frontend/.env to override defaults locally. NEVER commit .env.
# Vite only exposes variables prefixed with VITE_ to the browser (baked at build time).

# Base URL of the FounderMate API.
# PRODUCTION: set this to the deployed API origin before building
# (e.g. VITE_API_URL=https://api.your-domain.com). Do NOT ship localhost.
# Development default when unset: http://localhost:5255
VITE_API_URL=http://localhost:5255